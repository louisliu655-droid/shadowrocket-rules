#!name=共享分流规则（Shadowrocket）
#!desc=仅同步分流规则；节点和代理分组由各设备自行管理。先在编辑参数中确认本地策略名称。包含最终匹配规则。
#!arguments=ChatGPT:chatgpt,Gemini:Gemini,Claude:CLAUDE,AI:ai,TikTok:Tiktok,Video:Watchthevideo,SelfHosted:自建的,Auto:所有中最快的,Final:其他都走这个
#!arguments-desc=各参数填写本机已有的代理分组名；可填写 PROXY 使用本机代理。Final 为最终未命中流量的策略。

[Rule]
# YouTube：网页、视频流、缩略图及专属接口
DOMAIN-SUFFIX,youtube.com,{{{Video}}}
DOMAIN-SUFFIX,googlevideo.com,{{{Video}}}
DOMAIN-SUFFIX,ytimg.com,{{{Video}}}
DOMAIN-SUFFIX,youtu.be,{{{Video}}}
DOMAIN-SUFFIX,youtube-nocookie.com,{{{Video}}}
DOMAIN,youtubei.googleapis.com,{{{Video}}}
DOMAIN,youtube.googleapis.com,{{{Video}}}
DOMAIN,yt3.ggpht.com,{{{Video}}}
DOMAIN,yt4.ggpht.com,{{{Video}}}

DOMAIN-KEYWORD,.cn,DIRECT
DOMAIN,notes.louisliu.net.cn,DIRECT
DOMAIN,sync.louisliu.net.cn,DIRECT
IP-CIDR,111.229.103.218/32,DIRECT
# 已跳过一条字段错位的旧记录；eudic.net 的有效直连规则在下方保留。
DOMAIN-SUFFIX,bilibili.com,DIRECT
